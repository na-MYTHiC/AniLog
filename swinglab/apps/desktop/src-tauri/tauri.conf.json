{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwingLab",
  "version": "0.1.0",
  "identifier": "com.swinglab.app",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @swinglab/app dev",
    "beforeBuildCommand": "pnpm --filter @swinglab/app build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SwingLab",
        "width": 1000,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
